{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI System config (ui.config.json)",
  "description": "One file per project. Every key is optional; missing keys fall back to the neutral defaults.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Project name."
    },
    "brand": {
      "type": "object",
      "properties": {
        "wordmark": {
          "type": "string"
        },
        "caption": {
          "type": "string",
          "description": "Empty hides it."
        },
        "initials": {
          "type": "string",
          "maxLength": 2
        },
        "mark": {
          "enum": [
            "monogram",
            "ring",
            "spark",
            "stack",
            "orbit",
            "none",
            "custom"
          ]
        },
        "logoSrc": {
          "type": "string",
          "description": "Full logo image URL; replaces the generated lockup."
        },
        "markSrc": {
          "type": "string",
          "description": "Mark-only image URL for rails, docks, favicons."
        },
        "markSvg": {
          "type": "string",
          "description": "Inline SVG markup for a custom mark (use currentColor)."
        },
        "variant": {
          "enum": [
            "lockup",
            "stacked",
            "mark",
            "wordmark"
          ]
        },
        "placement": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "wordmarkCase": {
          "enum": [
            "normal",
            "upper"
          ]
        },
        "wordmarkFont": {
          "enum": [
            "display",
            "body"
          ]
        },
        "markTone": {
          "enum": [
            "current",
            "primary"
          ]
        },
        "wordmarkColor": {
          "type": "string",
          "description": "Wordmark hex. Unset follows the text color."
        }
      }
    },
    "color": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "neutral": {
          "type": "string",
          "description": "Hex, or 'auto' to borrow the primary's hue."
        },
        "success": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        },
        "danger": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "pin": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact light-mode values on generated roles (bg, line, ink-2, primary-hover, focus-field, search-bg, nav-bg...)."
        },
        "pinDark": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact dark-mode values on the same roles. Unpinned dark roles are derived."
        }
      }
    },
    "radius": {
      "type": "object",
      "properties": {
        "roundness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "0 = sharp, 100 = fully rounded."
        },
        "pill": {
          "type": "boolean",
          "description": "Full pills for controls, chips, inputs and nav shells."
        },
        "overrides": {
          "type": "object",
          "properties": {
            "chip": {
              "type": "number"
            },
            "control": {
              "type": "number"
            },
            "field": {
              "type": "number"
            },
            "card": {
              "type": "number"
            },
            "panel": {
              "type": "number"
            },
            "media": {
              "type": "number"
            },
            "shell": {
              "type": "number"
            },
            "search": {
              "type": "number"
            },
            "avatar": {
              "type": "number"
            }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "modern",
            "geometric",
            "editorial",
            "grotesk",
            "humanist",
            "classic",
            "retail"
          ]
        },
        "display": {
          "type": "string",
          "description": "Any Google Fonts family."
        },
        "body": {
          "type": "string"
        },
        "mono": {
          "type": "string"
        },
        "buttonCase": {
          "enum": [
            "normal",
            "upper"
          ]
        }
      }
    },
    "density": {
      "enum": [
        "compact",
        "comfortable",
        "spacious"
      ]
    },
    "surface": {
      "type": "object",
      "properties": {
        "float": {
          "enum": [
            "solid",
            "glass"
          ]
        },
        "shadow": {
          "enum": [
            "none",
            "soft",
            "medium",
            "deep"
          ]
        },
        "border": {
          "enum": [
            "hairline",
            "none"
          ]
        },
        "shadows": {
          "type": "object",
          "properties": {
            "sm": {
              "type": "string"
            },
            "md": {
              "type": "string"
            },
            "lg": {
              "type": "string"
            },
            "float": {
              "type": "string"
            }
          },
          "description": "Exact light-mode box-shadows."
        }
      }
    },
    "nav": {
      "type": "object",
      "properties": {
        "front": {
          "enum": [
            "dock",
            "island",
            "bar",
            "stacked",
            "minimal"
          ]
        },
        "back": {
          "enum": [
            "sidebar",
            "rail",
            "inset",
            "topbar",
            "dock"
          ]
        }
      }
    },
    "avatars": {
      "type": "object",
      "properties": {
        "style": {
          "enum": [
            "notionists-neutral",
            "lorelei-neutral",
            "thumbs",
            "glass",
            "shapes",
            "initials"
          ],
          "description": "DiceBear style (CC0) for people without a photo."
        }
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intensity": {
          "enum": [
            "subtle",
            "expressive"
          ]
        },
        "timing": {
          "type": "object",
          "properties": {
            "fast": {
              "type": "number"
            },
            "base": {
              "type": "number"
            },
            "slow": {
              "type": "number"
            },
            "easeOut": {
              "type": "string"
            },
            "easeInOut": {
              "type": "string"
            },
            "press": {
              "type": "string"
            }
          }
        }
      }
    },
    "preset": {
      "enum": [
        "ledger",
        "atelier",
        "retail-editorial"
      ],
      "description": "Preset: a way of designing, applied between the defaults and your keys. ledger = round and clean, atelier = sharp and editorial. retail-editorial is the old name of atelier. See docs/presets.md."
    },
    "kind": {
      "enum": [
        "shop",
        "app",
        "website",
        "booking",
        "portfolio"
      ],
      "description": "What you build, picked separately from the preset. Sets no values; tools read it for the page set and questions. See docs/kinds.md."
    },
    "sizes": {
      "type": "object",
      "properties": {
        "sm": {
          "type": "number"
        },
        "md": {
          "type": "number"
        },
        "lg": {
          "type": "number"
        },
        "pad": {
          "type": "number"
        },
        "gap": {
          "type": "number"
        },
        "ring": {
          "type": "number"
        },
        "check": {
          "type": "number"
        }
      },
      "description": "Pin control heights, card padding/gap, field focus ring width and checkbox edge width in px."
    },
    "space": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Spacing scale in px for token exports."
    }
  }
}
